{
  "name": "miniblox-local-server",
  "version": "1.0.0",
  "description": "Offline / Local standalone server for Miniblox with flat world generation and camera controls patches.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run ./src/index.ts",
    "dev": "bun run --watch ./src/index.ts",
    "node-start": "tsx ./src/index.ts",
    "node-dev": "tsx watch ./src/index.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@msgpack/msgpack": "^3.1.3",
    "engine.io": "^6.6.8",
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
